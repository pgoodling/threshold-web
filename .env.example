# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API.

# --- PUBLIC (browser-safe) ---
# Publishable/anon values. Safe to ship in the browser bundle; RLS protects the
# data. Must be prefixed NEXT_PUBLIC_ to be inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# --- SERVER-ONLY SECRETS ---
# NEVER prefix these with NEXT_PUBLIC_ and never commit real values. They run
# only in API routes and must also be set in Vercel's env vars.

# Supabase service-role key (bypasses RLS). Used by the Twilio inbound webhook
# and the authenticated send route. Treat like a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe secret key (card-on-file).
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Twilio (SMS). The auth token also verifies the inbound webhook signature.
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Optional — only if the inbound webhook URL can't be inferred from request
# headers. Must match the URL configured in Twilio.
# TWILIO_WEBHOOK_URL=https://threshold.salon/api/sms/inbound

# Evelyn's own mobile. Two things use it:
#
#   * click-to-call (/api/voice/click-to-call) — Twilio rings THIS phone first,
#     then bridges her to the client as the salon number. The route 503s with a
#     message until it's set.
#   * the short-notice booking alert (/api/sms/new-booking) — a text when a
#     booking lands inside her next 24 hours. Gated on SMS_AUTOMATION_ENABLED,
#     so it sends nothing until the A2P campaign clears.
#
# Her personal mobile, never TWILIO_PHONE_NUMBER — for the call it would loop
# back on itself, and for the text it would be the number texting itself.
#
# Not optional, and it fails quietly if you unset it. This is a delivery
# address, not a second business identity: clients never see it and it is never
# a From. The salon number is virtual — it has no speaker and no screen — so
# without this there is nothing for an incoming call to ring, and
# /api/voice/incoming sends every caller straight to voicemail while the studio
# Call button starts answering 503. Nobody is told; the phone just stops
# ringing.
SALON_OWNER_PHONE=+1XXXXXXXXXX

# Resend (email confirmations + reminders). Unlike SMS this needs no carrier
# registration, so it works as soon as the sending domain is verified.
# EMAIL_FROM must be on a domain verified in Resend, or sends are rejected.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Threshold <hello@threshold.salon>
# Where client replies land. Defaults to no reply-to if unset.
EMAIL_REPLY_TO=hello@threshold.salon

# Shared secret for the cron endpoints (/api/cron/reminders,
# /api/cron/late-arrivals). Vercel Cron sends it as "Authorization: Bearer
# <secret>". Generate any long random string. The routes REFUSE to run when this
# is unset — without it they'd message every upcoming client to anyone who found
# the URL.
CRON_SECRET=some-long-random-string

# Master switch for AUTOMATED texting: reminders, "still on your way?", and the
# acknowledgement after a client replies C. Evelyn's own replies from the
# Messages tab are unaffected by this.
#
# Must be the exact string "true" to send; anything else (including unset) means
# every automated send is skipped with reason "automation_off". Leave it off
# until the A2P 10DLC campaign is approved — the sends would be rejected by the
# carriers anyway, and an explicit flag means switching on is a config change
# rather than a deploy.
SMS_AUTOMATION_ENABLED=false
