{
  "name": "threshold-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:db": "node --import tsx --test \"tests/db/*.test.ts\"",
    "walks": "playwright test walks",
    "audit": "playwright test audit",
    "test:all": "npm test && npm run test:db && npm run walks",
    "rig:start": "node tests/rig/prepare-migrations.mjs && npx supabase start --workdir tests/rig",
    "rig:reset": "node tests/rig/prepare-migrations.mjs && npx supabase db reset --workdir tests/rig",
    "rig:stop": "npx supabase stop --workdir tests/rig"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/supabase-js": "^2.110.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.9",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
